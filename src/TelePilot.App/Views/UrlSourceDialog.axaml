<Window
    x:Class="TelePilot.App.Views.UrlSourceDialog"
    x:DataType="vm:UrlSourceDialogViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:TelePilot.App.Localization"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:controls="using:TelePilot.App.Controls"
    xmlns:vm="using:TelePilot.App.ViewModels"
    Width="560"
    Height="390"
    MinWidth="440"
    MinHeight="350"
    CanResize="False"
    ShowInTaskbar="False"
    Title="{x:Static loc:ViewText.AddPlaylistFromURL}"
    WindowStartupLocation="CenterOwner"
    automation:AutomationProperties.Name="{x:Static loc:ViewText.AddPlaylistFromURL}"
    automation:AutomationProperties.AutomationId="url-source-dialog">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
    <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}" />
  </Window.KeyBindings>

  <Grid
      Margin="20"
      RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
      RowSpacing="12"
      KeyboardNavigation.TabNavigation="Cycle">
    <TextBlock
        Classes="section-heading"
        Text="{x:Static loc:ViewText.AddPlaylistFromURL}"
        automation:AutomationProperties.HeadingLevel="1" />

    <StackPanel Grid.Row="1">
      <Label Classes="field-label" Content="{x:Static loc:ViewText.SourceNameOptional}" Target="SourceNameTextBox" />
      <controls:AccessibleTextBox
          x:Name="SourceNameTextBox"
          Text="{Binding SourceName}"
          Watermark="{x:Static loc:ViewText.ExampleHomeTV}"
          automation:AutomationProperties.Name="{x:Static loc:ViewText.SourceName}"
          automation:AutomationProperties.HelpText="{x:Static loc:ViewText.ANameToHelpYouRecognize}"
          automation:AutomationProperties.AutomationId="url-source-name" />
    </StackPanel>

    <StackPanel Grid.Row="2">
      <Label Classes="field-label" Content="{x:Static loc:ViewText.PlaylistAddress}" Target="AddressTextBox" />
      <controls:AccessibleTextBox
          x:Name="AddressTextBox"
          Text="{Binding Address}"
          Watermark="https://example.org/playlist.m3u8"
          automation:AutomationProperties.Name="{x:Static loc:ViewText.PlaylistAddress2}"
          automation:AutomationProperties.HelpText="{x:Static loc:ViewText.FullHTTPOrHTTPSAddressTo}"
          automation:AutomationProperties.AutomationId="url-source-address" />
    </StackPanel>

    <CheckBox
        x:Name="RefreshOnStartupCheckBox"
        Grid.Row="3"
        Content="{x:Static loc:ViewText.RefreshThisSourceWhenTheApp}"
        IsChecked="{Binding RefreshOnStartup}"
        automation:AutomationProperties.Name="{x:Static loc:ViewText.RefreshSourceAtStartup}"
        automation:AutomationProperties.AutomationId="url-source-refresh-on-startup" />

    <TextBlock
        Grid.Row="4"
        Text="{Binding ValidationMessage}"
        TextWrapping="Wrap"
        Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
        automation:AutomationProperties.Name="{x:Static loc:ViewText.PlaylistSourceFormError}"
        automation:AutomationProperties.AutomationId="url-source-validation"
        automation:AutomationProperties.LiveSetting="Assertive" />

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button
          x:Name="CancelButton"
          Classes="primary-action"
          Content="{x:Static loc:ViewText.Cancel}"
          Command="{Binding CancelCommand}"
          automation:AutomationProperties.Name="{x:Static loc:ViewText.CancelAddingTheSource}"
          automation:AutomationProperties.AutomationId="url-source-cancel" />
      <Button
          x:Name="SubmitButton"
          Classes="primary-action"
          Content="{x:Static loc:ViewText.Add}"
          Command="{Binding SubmitCommand}"
          automation:AutomationProperties.Name="{x:Static loc:ViewText.AddURLSource}"
          automation:AutomationProperties.HelpText="{x:Static loc:ViewText.ValidatesTheAddressAndAddsThe}"
          automation:AutomationProperties.AutomationId="url-source-submit" />
    </StackPanel>
  </Grid>
</Window>
