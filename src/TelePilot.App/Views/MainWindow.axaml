<Window
    x:Class="TelePilot.App.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:TelePilot.App.Localization"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:controls="using:TelePilot.App.Controls"
    xmlns:vm="using:TelePilot.App.ViewModels"
    xmlns:views="using:TelePilot.App.Views"
    Width="1180"
    Height="760"
    MinWidth="780"
    MinHeight="560"
    Icon="/Assets/TelePilot.png"
    Title="{x:Static loc:ViewText.TelePilotAccessibleIPTVPlayer}"
    WindowStartupLocation="CenterScreen"
    automation:AutomationProperties.Name="{x:Static loc:ViewText.TelePilotAccessibleIPTVPlayer2}"
    automation:AutomationProperties.AutomationId="main-window">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding OpenPlaylistManagerCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenPlaylistManagerForFileCommand}" />
    <KeyBinding Gesture="Ctrl+U" Command="{Binding OpenPlaylistManagerForUrlCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding StopCommand}" />
    <KeyBinding Gesture="Ctrl+M" Command="{Binding ToggleMuteCommand}" />
    <KeyBinding Gesture="Ctrl+T" Command="{Binding OpenAudioTracksCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+T" Command="{Binding OpenSubtitleTracksCommand}" />
    <KeyBinding Gesture="Ctrl+L" Command="{Binding ToggleChannelListCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding OpenProgramGuideCommand}" />
  </Window.KeyBindings>

  <Grid
      x:Name="MainFocusCycle"
      RowDefinitions="Auto,Auto,*,Auto"
      KeyboardNavigation.TabNavigation="Cycle">
    <Menu
        x:Name="MainMenu"
        Grid.Row="0"
        IsTabStop="False"
        KeyboardNavigation.TabNavigation="None"
        automation:AutomationProperties.Name="{x:Static loc:ViewText.MainMenu}"
        automation:AutomationProperties.HelpText="{x:Static loc:ViewText.PressAltOrF10ToActivate}"
        automation:AutomationProperties.AutomationId="main-menu">
      <MenuItem Header="{x:Static loc:ViewText.File}" IsTabStop="False" automation:AutomationProperties.Name="{x:Static loc:ViewText.File2}" automation:AutomationProperties.AccessKey="{x:Static loc:ViewText.AltF}" automation:AutomationProperties.AutomationId="menu-file">
        <MenuItem
            Header="{x:Static loc:ViewText.PlaylistManager}"
            InputGesture="Ctrl+Shift+P"
            Command="{Binding OpenPlaylistManagerCommand}"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.PlaylistManager2}"
            automation:AutomationProperties.AutomationId="menu-playlist-manager" />
        <Separator />
        <MenuItem
            Header="{x:Static loc:ViewText.Settings}"
            Command="{Binding OpenSettingsCommand}"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.OpenSettings}"
            automation:AutomationProperties.AutomationId="menu-settings" />
        <Separator />
        <MenuItem
            Header="{x:Static loc:ViewText.Exit}"
            InputGesture="Alt+F4"
            Command="{Binding CloseApplicationCommand}"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.ExitTelePilot}"
            automation:AutomationProperties.AutomationId="menu-exit" />
      </MenuItem>

      <MenuItem Header="{x:Static loc:ViewText.Playback}" IsTabStop="False" automation:AutomationProperties.Name="{x:Static loc:ViewText.Playback2}" automation:AutomationProperties.AccessKey="{x:Static loc:ViewText.AltP}" automation:AutomationProperties.AutomationId="menu-playback">
        <MenuItem
            Header="{x:Static loc:ViewText.PlaySelectedChannel}"
            InputGesture="Enter"
            Command="{Binding PlaySelectedCommand}"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.PlaySelectedChannel3}"
            automation:AutomationProperties.AutomationId="menu-play-selected" />
        <MenuItem
            Header="{x:Static loc:ViewText.PauseOrResume}"
            InputGesture="Space"
            Command="{Binding PauseResumeCommand}"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.PauseOrResume2}"
            automation:AutomationProperties.AutomationId="menu-pause-resume" />
        <MenuItem
            Header="{x:Static loc:ViewText.Stop}"
            InputGesture="Ctrl+S"
            Command="{Binding StopCommand}"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.StopPlayback}"
            automation:AutomationProperties.AutomationId="menu-stop" />
        <Separator />
        <MenuItem
            Header="{x:Static loc:ViewText.MuteOrUnmute}"
            InputGesture="Ctrl+M"
            Command="{Binding ToggleMuteCommand}"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.MuteOrUnmute2}"
            automation:AutomationProperties.AutomationId="menu-mute" />
        <MenuItem
            Header="{x:Static loc:ViewText.AudioTrack}"
            InputGesture="Ctrl+T"
            Command="{Binding OpenAudioTracksCommand}"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.ChooseAudioTrack}"
            automation:AutomationProperties.AutomationId="menu-audio-track" />
        <MenuItem
            Header="{x:Static loc:ViewText.Subtitles}"
            InputGesture="Ctrl+Shift+T"
            Command="{Binding OpenSubtitleTracksCommand}"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.ChooseSubtitles}"
            automation:AutomationProperties.AutomationId="menu-subtitle-track" />
        <MenuItem
            Header="{x:Static loc:ViewText.FullScreen}"
            InputGesture="F11"
            Command="{Binding ToggleFullscreenCommand}"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.ToggleFullScreen}"
            automation:AutomationProperties.AutomationId="menu-fullscreen" />
      </MenuItem>

      <MenuItem Header="{x:Static loc:ViewText.Record}" IsTabStop="False" automation:AutomationProperties.Name="{x:Static loc:ViewText.Recording}" automation:AutomationProperties.AccessKey="{x:Static loc:ViewText.AltR}" automation:AutomationProperties.AutomationId="menu-recording">
        <MenuItem Header="{x:Static loc:ViewText.RecordVideoInTSFormat}" Command="{Binding StartVideoRecordingCommand}" automation:AutomationProperties.Name="{x:Static loc:ViewText.StartVideoRecordingInTheOriginal}" automation:AutomationProperties.AutomationId="menu-record-video" />
        <MenuItem Header="{x:Static loc:ViewText.RecordAudio}" Command="{Binding StartAudioRecordingCommand}" automation:AutomationProperties.Name="{x:Static loc:ViewText.StartAudioRecording}" automation:AutomationProperties.AutomationId="menu-record-audio" />
        <MenuItem Header="{x:Static loc:ViewText.StopRecording}" Command="{Binding StopRecordingCommand}" automation:AutomationProperties.Name="{x:Static loc:ViewText.StopActiveRecording}" automation:AutomationProperties.AutomationId="menu-stop-recording" />
        <Separator />
        <MenuItem Header="{x:Static loc:ViewText.ScheduleRecording}" Command="{Binding ScheduleRecordingCommand}" automation:AutomationProperties.Name="{x:Static loc:ViewText.ScheduleRecordingForTheSelectedChannel}" automation:AutomationProperties.AutomationId="menu-schedule-recording" />
        <MenuItem Header="{x:Static loc:ViewText.ScheduledRecordings}" Command="{Binding ShowScheduledRecordingsCommand}" automation:AutomationProperties.Name="{x:Static loc:ViewText.ShowScheduledRecordings}" automation:AutomationProperties.AutomationId="menu-scheduled-recordings" />
      </MenuItem>

      <MenuItem x:Name="FavoritesMenu" Header="{x:Static loc:ViewText.Favorites}" IsTabStop="False" automation:AutomationProperties.Name="{x:Static loc:ViewText.Favorites2}" automation:AutomationProperties.AccessKey="{x:Static loc:ViewText.AltA}" automation:AutomationProperties.AutomationId="menu-favorites">
        <MenuItem Header="{x:Static loc:ViewText.AddCurrentChannelToFavorites}" Command="{Binding AddCurrentToFavoritesCommand}" automation:AutomationProperties.Name="{x:Static loc:ViewText.AddCurrentChannelToFavorites2}" automation:AutomationProperties.AutomationId="menu-favorite-current" />
        <MenuItem Header="{x:Static loc:ViewText.FavoritesList}" Command="{Binding ToggleFavoritesFilterCommand}" automation:AutomationProperties.Name="{x:Static loc:ViewText.ShowTheListOfFavoriteChannels}" automation:AutomationProperties.AutomationId="menu-favorites-list" />
        <Separator Tag="favorites-static-end" />
      </MenuItem>

      <MenuItem Header="{x:Static loc:ViewText.View}" IsTabStop="False" automation:AutomationProperties.Name="{x:Static loc:ViewText.View2}" automation:AutomationProperties.AccessKey="{x:Static loc:ViewText.AltV}" automation:AutomationProperties.AutomationId="menu-view">
        <MenuItem
            Header="{x:Static loc:ViewText.ChannelList}"
            InputGesture="Ctrl+L"
            Command="{Binding ToggleChannelListCommand}"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.ShowOrHideChannelList}"
            automation:AutomationProperties.AutomationId="menu-channel-list" />
        <MenuItem
            Header="{x:Static loc:ViewText.TVGuide}"
            InputGesture="Ctrl+E"
            Command="{Binding OpenProgramGuideCommand}"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.OpenTVGuide}"
            automation:AutomationProperties.AutomationId="menu-program-guide" />
      </MenuItem>

      <MenuItem Header="{x:Static loc:ViewText.Help}" IsTabStop="False" automation:AutomationProperties.Name="{x:Static loc:ViewText.Help2}" automation:AutomationProperties.AccessKey="{x:Static loc:ViewText.AltH}" automation:AutomationProperties.AutomationId="menu-help">
        <MenuItem
            Header="{x:Static loc:ViewText.KeyboardShortcuts}"
            Command="{Binding OpenKeyboardShortcutsCommand}"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.OpenKeyboardShortcuts}"
            automation:AutomationProperties.AutomationId="menu-keyboard-shortcuts" />
      </MenuItem>
    </Menu>

    <TabControl x:Name="SectionTabs" Grid.Row="1" Margin="12,0"
                IsVisible="{Binding IsChannelListViewVisible}"
                SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}"
                automation:AutomationProperties.Name="{x:Static loc:ViewText.TVSections}"
                automation:AutomationProperties.AutomationId="main-section-tabs">
      <TabItem Header="{x:Static loc:ViewText.LiveTV}" automation:AutomationProperties.Name="{x:Static loc:ViewText.LiveTV}" automation:AutomationProperties.AutomationId="tab-live" />
      <TabItem Header="{x:Static loc:ViewText.Favorites2}" automation:AutomationProperties.Name="{x:Static loc:ViewText.Favorites2}" automation:AutomationProperties.AutomationId="tab-favorites" />
      <TabItem Header="{x:Static loc:ViewText.Archive}" automation:AutomationProperties.Name="{x:Static loc:ViewText.Archive}" automation:AutomationProperties.AutomationId="tab-archive" />
    </TabControl>

    <Grid Grid.Row="2" Margin="12" ColumnDefinitions="3*,2*" ColumnSpacing="12">
      <Grid
          x:Name="ChannelListView"
          Grid.Column="0"
          Grid.ColumnSpan="{Binding ChannelListColumnSpan}"
          IsEnabled="{Binding IsChannelsViewEnabled}"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="10">
        <Grid
            x:Name="ChannelFiltersPanel"
            ColumnDefinitions="2*,1.2*"
            ColumnSpacing="8"
            IsVisible="{Binding IsChannelsViewEnabled}">
          <StackPanel>
            <Label x:Name="ChannelSearchLabel" Classes="field-label" Content="{Binding SearchLabel}" Target="SearchBox" />
            <controls:AccessibleSearchBox
                x:Name="SearchBox"
                Text="{Binding SearchText, Mode=OneWayToSource}"
                Watermark="{Binding SearchWatermark}"
                automation:AutomationProperties.Name="{Binding SearchAccessibleName}"
                automation:AutomationProperties.HelpText="{Binding SearchHelpText}"
                automation:AutomationProperties.AutomationId="channel-search" />
          </StackPanel>
          <StackPanel Grid.Column="1" IsVisible="{Binding IsChannelGroupFilterVisible}">
            <Label Classes="field-label" Content="{x:Static loc:ViewText.Group}" Target="GroupSelector" />
            <controls:AccessibleComboBox
                x:Name="GroupSelector"
                ItemsSource="{Binding Groups}"
                SelectedItem="{Binding SelectedGroup}"
                automation:AutomationProperties.Name="{Binding GroupSelectorAccessibleName}"
                automation:AutomationProperties.HelpText="{x:Static loc:ViewText.UseUpOrDownToSelect}"
                automation:AutomationProperties.AutomationId="channel-group-filter" />
          </StackPanel>
        </Grid>

        <ListBox
            x:Name="ChannelList"
            Grid.Row="1"
            IsTextSearchEnabled="False"
            ItemsSource="{Binding Channels}"
            SelectedItem="{Binding SelectedChannel}"
            ContainerPrepared="OnChannelContainerPrepared"
            DoubleTapped="OnChannelDoubleTapped"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.Channels}"
            automation:AutomationProperties.AutomationId="channel-list">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem
                  Header="{x:Static loc:ViewText.Play}"
                  Command="{Binding PlaySelectedCommand}"
                  automation:AutomationProperties.Name="{x:Static loc:ViewText.PlaySelectedChannel3}"
                  automation:AutomationProperties.AutomationId="channel-context-play" />
              <MenuItem
                  Header="{x:Static loc:ViewText.TVGuide2}"
                  Command="{Binding OpenProgramGuideCommand}"
                  automation:AutomationProperties.Name="{x:Static loc:ViewText.TVGuideForTheSelectedChannel}"
                  automation:AutomationProperties.AutomationId="channel-context-epg" />
              <MenuItem
                  Header="{Binding SelectedFavoriteMenuText}"
                  Command="{Binding ToggleFavoriteCommand}"
                  automation:AutomationProperties.Name="{Binding SelectedFavoriteMenuText}"
                  automation:AutomationProperties.AutomationId="channel-context-favorite" />
              <MenuItem
                  Header="{x:Static loc:ViewText.ScheduleRecording3}"
                  Command="{Binding ScheduleRecordingCommand}"
                  automation:AutomationProperties.Name="{x:Static loc:ViewText.ScheduleRecordingForTheSelectedChannel}"
                  automation:AutomationProperties.AutomationId="channel-context-schedule-recording" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ChannelListItemViewModel">
              <TextBlock
                  Text="{Binding AccessibleName}"
                  TextWrapping="Wrap"
                  automation:AutomationProperties.AccessibilityView="Raw" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Grid
            x:Name="ChannelActionsPanel"
            Grid.Row="2"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="8"
            IsVisible="{Binding IsChannelsViewEnabled}">
          <TextBlock
              VerticalAlignment="Center"
              Text="{Binding ChannelCountText}"
              automation:AutomationProperties.Name="{Binding ChannelCountText}"
              automation:AutomationProperties.AutomationId="channel-count" />
          <Button
              Grid.Column="1"
              x:Name="ManageFavoritesButton"
              Content="{x:Static loc:ViewText.ManageFavorites2}"
              IsVisible="{Binding IsFavoritesSection}"
              Command="{Binding ManageFavoritesCommand}"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.ManageFavoriteChannels}"
              automation:AutomationProperties.AutomationId="manage-favorites" />
          <Button
              x:Name="PlaySelectedChannelButton"
              Grid.Column="2"
              Classes="primary-action"
              Content="{x:Static loc:ViewText.Play}"
              Command="{Binding PlaySelectedCommand}"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.PlaySelectedChannel3}"
              automation:AutomationProperties.AutomationId="play-selected-channel" />
        </Grid>
      </Grid>

      <Border Grid.Column="0"
          Grid.ColumnSpan="{Binding ChannelListColumnSpan}" ZIndex="1"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          IsVisible="{Binding IsArchiveViewVisible}">
        <views:ArchiveView x:Name="ArchivePane" DataContext="{Binding Archive}" />
      </Border>

      <Grid
          x:Name="PlayerView"
          Grid.Column="{Binding PlayerColumn}"
          Grid.ColumnSpan="{Binding PlayerColumnSpan}"
          Panel.ZIndex="2"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          IsVisible="{Binding IsPlayerViewVisible}"
          RowDefinitions="Auto,*,Auto,Auto,Auto"
          RowSpacing="10">
        <TextBlock
            Classes="section-heading"
            Text="{Binding PlaybackHeading}"
            automation:AutomationProperties.HeadingLevel="2" />

        <Border Grid.Row="1" Background="Black" MinHeight="220">
          <controls:AccessibleVideoView
              x:Name="VideoView"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.CurrentChannelVideo}"
              automation:AutomationProperties.HelpText="{x:Static loc:ViewText.TheVideoCannotTakeFocusPlayer}"
              automation:AutomationProperties.AutomationId="video-view"
              automation:AutomationProperties.AccessibilityView="Raw" />
        </Border>

        <StackPanel Grid.Row="2" Spacing="4">
          <TextBlock
              FontSize="18"
              FontWeight="SemiBold"
              Text="{Binding CurrentChannelName}"
              TextWrapping="Wrap"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.CurrentChannel}"
              automation:AutomationProperties.AutomationId="current-channel" />
          <TextBlock
              Text="{Binding CurrentProgramName}"
              TextWrapping="Wrap"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.CurrentProgram}"
              automation:AutomationProperties.AutomationId="current-program" />
          <TextBlock
              Text="{Binding PlaybackStateText}"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.PlaybackStatus}"
              automation:AutomationProperties.AutomationId="playback-state" />
          <TextBlock
              Text="{Binding VolumeText}"
              automation:AutomationProperties.Name="{Binding VolumeText}"
              automation:AutomationProperties.AutomationId="playback-volume" />
          <TextBlock
              Text="{Binding RecordingStatusText}"
              automation:AutomationProperties.Name="{Binding RecordingStatusText}"
              automation:AutomationProperties.LiveSetting="Polite"
              automation:AutomationProperties.AutomationId="recording-status" />
        </StackPanel>

        <WrapPanel Grid.Row="3" HorizontalAlignment="Left" ItemHeight="38">
            <Button
                x:Name="PauseResumeButton"
                Margin="0,0,8,8"
                Content="{x:Static loc:ViewText.PauseResume}"
                Command="{Binding PauseResumeCommand}"
                automation:AutomationProperties.Name="{x:Static loc:ViewText.PauseOrResume2}"
                automation:AutomationProperties.AutomationId="pause-resume" />
            <Button
                Margin="0,0,8,8"
                Content="{x:Static loc:ViewText.Stop2}"
                Command="{Binding StopCommand}"
                automation:AutomationProperties.Name="{x:Static loc:ViewText.StopPlayback}"
                automation:AutomationProperties.AutomationId="stop-playback" />
            <Button
                Margin="0,0,8,8"
                Content="{Binding MuteButtonText}"
                Command="{Binding ToggleMuteCommand}"
                automation:AutomationProperties.Name="{Binding MuteButtonText}"
                automation:AutomationProperties.AutomationId="toggle-mute" />
            <Button
                Margin="0,0,8,8"
                Content="{x:Static loc:ViewText.AudioTrack2}"
                Command="{Binding OpenAudioTracksCommand}"
                automation:AutomationProperties.Name="{x:Static loc:ViewText.ChooseAudioTrack}"
                automation:AutomationProperties.AutomationId="select-audio-track" />
            <Button
                Margin="0,0,8,8"
                Content="{x:Static loc:ViewText.Subtitles2}"
                Command="{Binding OpenSubtitleTracksCommand}"
                automation:AutomationProperties.Name="{x:Static loc:ViewText.ChooseSubtitles}"
                automation:AutomationProperties.AutomationId="select-subtitle-track" />
            <Button
                x:Name="RecordingButton"
                Margin="0,0,8,8"
                Content="{Binding RecordingButtonText}"
                Click="OnRecordingButtonClick"
                automation:AutomationProperties.Name="{Binding RecordingButtonText}"
                automation:AutomationProperties.HelpText="{x:Static loc:ViewText.OpensTheMenuForRecordingVideo}"
                automation:AutomationProperties.AutomationId="recording-menu-button">
              <Button.ContextMenu>
                <ContextMenu x:Name="PlayerRecordingMenu">
                  <MenuItem Header="{x:Static loc:ViewText.RecordVideoInTSFormat2}" Command="{Binding StartVideoRecordingCommand}" automation:AutomationProperties.Name="{x:Static loc:ViewText.RecordVideoInTheOriginalTS}" />
                  <MenuItem Header="{x:Static loc:ViewText.RecordAudio2}" Command="{Binding StartAudioRecordingCommand}" automation:AutomationProperties.Name="{x:Static loc:ViewText.RecordAudio2}" />
                  <MenuItem Header="{x:Static loc:ViewText.StopRecording2}" Command="{Binding StopRecordingCommand}" automation:AutomationProperties.Name="{x:Static loc:ViewText.StopRecording2}" />
                  <Separator />
                  <MenuItem Header="{x:Static loc:ViewText.ScheduleRecording3}" Command="{Binding ScheduleRecordingCommand}" automation:AutomationProperties.Name="{x:Static loc:ViewText.ScheduleRecording2}" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Button
                x:Name="FullscreenButton"
                Margin="0,0,8,8"
                Content="{x:Static loc:ViewText.FullScreen2}"
                Command="{Binding ToggleFullscreenCommand}"
                automation:AutomationProperties.Name="{x:Static loc:ViewText.ToggleFullScreen}"
                automation:AutomationProperties.HelpText="{x:Static loc:ViewText.F11TogglesFullScreenEscapeExits}"
                automation:AutomationProperties.AutomationId="toggle-fullscreen" />
            <Button
                x:Name="ReturnToChannelListButton"
                Margin="0,0,8,8"
                Content="{Binding ReturnToListText}"
                Command="{Binding ReturnToChannelListCommand}"
                automation:AutomationProperties.Name="{Binding ReturnToListText}"
                automation:AutomationProperties.AutomationId="return-to-channel-list" />
        </WrapPanel>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,240,Auto" ColumnSpacing="8">
            <Label
                VerticalAlignment="Center"
                Content="{x:Static loc:ViewText.Volume}"
                Target="VolumeSlider" />
            <Slider
                x:Name="VolumeSlider"
                Grid.Column="1"
                Minimum="0"
                Maximum="100"
                SmallChange="5"
                LargeChange="10"
                TickFrequency="5"
                IsSnapToTickEnabled="True"
                Value="{Binding Volume, Mode=OneWay}"
                ValueChanged="OnVolumeSliderValueChanged"
                automation:AutomationProperties.Name="{x:Static loc:ViewText.Volume2}"
                automation:AutomationProperties.HelpText="{x:Static loc:ViewText.UseTheArrowKeysToAdjust}"
                automation:AutomationProperties.AutomationId="volume-slider" />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Text="{Binding VolumeText}"
                automation:AutomationProperties.AccessibilityView="Raw" />
        </Grid>
      </Grid>
    </Grid>

    <Border Grid.Row="3" Padding="12,8" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
      <StackPanel Spacing="2">
        <TextBlock
            Text="{Binding AccessibleStatus.StatusMessage}"
            TextWrapping="Wrap"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.ApplicationStatus}"
            automation:AutomationProperties.AutomationId="application-status"
            automation:AutomationProperties.LiveSetting="Polite" />
        <TextBlock
            Text="{Binding AccessibleStatus.AlertMessage}"
            TextWrapping="Wrap"
            Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.ImportantApplicationMessage}"
            automation:AutomationProperties.AutomationId="application-alert"
            automation:AutomationProperties.LiveSetting="Assertive" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
