<Window
    x:Class="TelePilot.App.Views.ScheduleRecordingWindow"
    x:DataType="vm:ScheduleRecordingViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:TelePilot.App.Localization"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:controls="using:TelePilot.App.Controls"
    xmlns:vm="using:TelePilot.App.ViewModels"
    Width="680"
    Height="610"
    MinWidth="580"
    MinHeight="520"
    Title="{x:Static loc:ViewText.ScheduleRecordingTelePilot}"
    WindowStartupLocation="CenterOwner"
    automation:AutomationProperties.Name="{x:Static loc:ViewText.ScheduleRecording2}"
    automation:AutomationProperties.AutomationId="schedule-recording-window">
  <Grid Margin="20" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="14" KeyboardNavigation.TabNavigation="Cycle">
    <TextBlock Classes="section-heading" Text="{x:Static loc:ViewText.ScheduleRecording2}" automation:AutomationProperties.HeadingLevel="1" />
    <StackPanel Grid.Row="1" Spacing="14">
      <StackPanel>
        <Label Classes="field-label" Content="{x:Static loc:ViewText.Channel}" Target="ChannelPicker" />
        <controls:AccessibleComboBox
            x:Name="ChannelPicker"
            ItemsSource="{Binding Channels}"
            SelectedItem="{Binding SelectedChannel}"
            DisplayMemberPath="Name"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.ChannelToRecord}"
            automation:AutomationProperties.AutomationId="schedule-channel" />
      </StackPanel>

      <TextBlock
          Text="{Binding ProgrammeLabel}"
          TextWrapping="Wrap"
          automation:AutomationProperties.Name="{x:Static loc:ViewText.ProgramSelectedForRecording}"
          automation:AutomationProperties.AutomationId="schedule-programme" />

      <Grid ColumnDefinitions="1.2*,1*" ColumnSpacing="10">
        <StackPanel>
          <Label Classes="field-label" Content="{x:Static loc:ViewText.StartDate}" Target="StartDatePicker" />
          <controls:AccessibleDatePicker
              x:Name="StartDatePicker"
              SelectedDate="{Binding StartDate}"
              Watermark="{x:Static loc:ViewText.YYYYMMDD}"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.RecordingStartDate}"
              automation:AutomationProperties.AutomationId="schedule-start-date" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <Label Classes="field-label" Content="{x:Static loc:ViewText.StartTime}" Target="StartTimeBox" />
          <controls:AccessibleTextBox
              x:Name="StartTimeBox"
              Text="{Binding StartTime}"
              Watermark="{x:Static loc:ViewText.HHMm}"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.RecordingStartTimeInHoursAnd}"
              automation:AutomationProperties.AutomationId="schedule-start-time" />
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="1.2*,1*" ColumnSpacing="10">
        <StackPanel>
          <Label Classes="field-label" Content="{x:Static loc:ViewText.EndDate}" Target="EndDatePicker" />
          <controls:AccessibleDatePicker
              x:Name="EndDatePicker"
              SelectedDate="{Binding EndDate}"
              Watermark="{x:Static loc:ViewText.YYYYMMDD}"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.RecordingEndDate}"
              automation:AutomationProperties.AutomationId="schedule-end-date" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <Label Classes="field-label" Content="{x:Static loc:ViewText.EndTime}" Target="EndTimeBox" />
          <controls:AccessibleTextBox
              x:Name="EndTimeBox"
              Text="{Binding EndTime}"
              Watermark="{x:Static loc:ViewText.HHMm}"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.RecordingEndTimeInHoursAnd}"
              automation:AutomationProperties.AutomationId="schedule-end-time" />
        </StackPanel>
      </Grid>

      <StackPanel>
        <Label Classes="field-label" Content="{x:Static loc:ViewText.RecordingMode}" Target="ModePicker" />
        <controls:AccessibleComboBox
            x:Name="ModePicker"
            ItemsSource="{Binding Modes}"
            SelectedItem="{Binding SelectedMode}"
            DisplayMemberPath="Name"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.RecordingMode2}"
            automation:AutomationProperties.AutomationId="schedule-mode" />
      </StackPanel>
    </StackPanel>

    <TextBlock
        Grid.Row="2"
        Text="{Binding ValidationMessage}"
        TextWrapping="Wrap"
        automation:AutomationProperties.Name="{x:Static loc:ViewText.RecordingScheduleError}"
        automation:AutomationProperties.LiveSetting="Assertive"
        automation:AutomationProperties.AutomationId="schedule-validation" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button
          x:Name="CancelButton"
          Content="{x:Static loc:ViewText.Cancel}"
          Command="{Binding CancelCommand}"
          automation:AutomationProperties.Name="{x:Static loc:ViewText.CancelSchedulingTheRecording}"
          automation:AutomationProperties.AutomationId="schedule-cancel" />
      <Button
          x:Name="SaveButton"
          Classes="primary-action"
          Content="{x:Static loc:ViewText.Schedule}"
          Command="{Binding SaveCommand}"
          automation:AutomationProperties.Name="{x:Static loc:ViewText.ScheduleRecording2}"
          automation:AutomationProperties.AutomationId="schedule-save" />
    </StackPanel>
  </Grid>
</Window>
