<UserControl
    x:Class="TelePilot.App.Views.ArchiveView"
    x:DataType="vm:ArchiveViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:TelePilot.App.Localization"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:controls="using:TelePilot.App.Controls"
    xmlns:vm="using:TelePilot.App.ViewModels"
    automation:AutomationProperties.Name="{x:Static loc:ViewText.TVArchive}"
    automation:AutomationProperties.AutomationId="archive-view">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="10"
        KeyboardNavigation.TabNavigation="Cycle">
    <TextBlock Text="{x:Static loc:ViewText.Archive}" Classes="section-heading"
               automation:AutomationProperties.HeadingLevel="1" />
    <Grid Grid.Row="1" ColumnDefinitions="2*,1.2*,Auto" ColumnSpacing="10">
      <StackPanel>
        <Label Classes="field-label" Content="{x:Static loc:ViewText.Channel}" Target="ChannelPicker" />
        <controls:AccessibleComboBox
            x:Name="ChannelPicker" ItemsSource="{Binding VisibleChannels}"
            SelectedItem="{Binding SelectedChannel}" DisplayMemberPath="Name"
            automation:AutomationProperties.Name="{Binding ChannelSelectorAccessibleName}"
            automation:AutomationProperties.HelpText="{x:Static loc:ViewText.UseTheArrowKeysToSelect4}"
            automation:AutomationProperties.AutomationId="archive-channel" />
      </StackPanel>
      <StackPanel Grid.Column="1">
        <Label Classes="field-label" Content="{x:Static loc:ViewText.Date}" Target="ArchiveDatePicker" />
        <controls:AccessibleComboBox
            x:Name="ArchiveDatePicker" ItemsSource="{Binding AvailableDates}"
            SelectedItem="{Binding SelectedDateOption}" DisplayMemberPath="DisplayName"
            automation:AutomationProperties.Name="{Binding DateSelectorAccessibleName}"
            automation:AutomationProperties.HelpText="{x:Static loc:ViewText.UseTheArrowKeysToSelect3}"
            automation:AutomationProperties.AutomationId="archive-date" />
      </StackPanel>
      <Button x:Name="ShowDayButton" Grid.Column="2" VerticalAlignment="Bottom"
              Content="{x:Static loc:ViewText.ShowDay}" Command="{Binding LoadCommand}"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.ReloadTheArchiveForTheSelected}"
              automation:AutomationProperties.AutomationId="archive-show-date" />
    </Grid>
    <StackPanel Grid.Row="2" Spacing="8">
      <TextBlock Text="{Binding ChannelSummary}" TextWrapping="Wrap"
                 automation:AutomationProperties.Name="{x:Static loc:ViewText.ArchiveChannelInformation}"
                 automation:AutomationProperties.AutomationId="archive-channel-summary" />
      <WrapPanel>
        <Button x:Name="PreviousDayButton" Margin="0,0,8,0" Content="{x:Static loc:ViewText.PreviousDay}"
                Command="{Binding PreviousDayCommand}"
                automation:AutomationProperties.Name="{x:Static loc:ViewText.PreviousArchiveDay}"
                automation:AutomationProperties.AutomationId="archive-previous-day" />
        <Button x:Name="NextDayButton" Content="{x:Static loc:ViewText.NextDay}" Command="{Binding NextDayCommand}"
                automation:AutomationProperties.Name="{x:Static loc:ViewText.NextArchiveDay}"
                automation:AutomationProperties.AutomationId="archive-next-day" />
      </WrapPanel>
      <TextBlock Text="{Binding AvailabilityMessage}" TextWrapping="Wrap"
                 automation:AutomationProperties.Name="{x:Static loc:ViewText.ArchiveAvailability}"
                 automation:AutomationProperties.AutomationId="archive-availability" />
      <CheckBox x:Name="ShowAllChannelsCheckBox"
                Content="{x:Static loc:ViewText.AlsoShowChannelsWithoutArchiveInformation}"
                IsChecked="{Binding ShowChannelsWithoutArchive}"
                automation:AutomationProperties.Name="{x:Static loc:ViewText.AlsoShowChannelsWithoutArchiveInformation}"
                automation:AutomationProperties.HelpText="{x:Static loc:ViewText.TheListShowsChannelsWithArchive}"
                automation:AutomationProperties.AutomationId="archive-show-all-channels" />
    </StackPanel>
    <Grid Grid.Row="3" ColumnDefinitions="1.2*,1*" ColumnSpacing="12">
      <Grid RowDefinitions="Auto,*">
        <Label Classes="field-label" Content="{x:Static loc:ViewText.Programs}" Target="ProgramList" />
        <ListBox x:Name="ProgramList" Grid.Row="1" ItemsSource="{Binding Programs}"
                 SelectedItem="{Binding SelectedProgram}" ContainerPrepared="OnProgramContainerPrepared"
                 automation:AutomationProperties.Name="{x:Static loc:ViewText.CompletedProgramsAvailableInTheArchive}"
                 automation:AutomationProperties.HelpText="{x:Static loc:ViewText.UseTheArrowKeysToSelect}"
                 automation:AutomationProperties.AutomationId="archive-programs">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ArchiveProgramItemViewModel">
              <TextBlock Padding="8,6" Text="{Binding AccessibleName}" TextWrapping="Wrap"
                         automation:AutomationProperties.AccessibilityView="Raw" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <Label Classes="field-label" Content="{x:Static loc:ViewText.ProgramDetails}" Target="ProgramDetails" />
        <controls:AccessibleTextBox
            x:Name="ProgramDetails" Grid.Row="1" Text="{Binding SelectedProgramDetails, Mode=OneWay}"
            IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.SelectedArchiveProgramDetails}"
            automation:AutomationProperties.HelpText="{x:Static loc:ViewText.ReadOnlyFieldUseTheArrow}"
            automation:AutomationProperties.AutomationId="archive-details" />
      </Grid>
    </Grid>
    <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" TextWrapping="Wrap"
               automation:AutomationProperties.Name="{x:Static loc:ViewText.ArchiveStatus}"
               automation:AutomationProperties.AutomationId="archive-status"
               automation:AutomationProperties.LiveSetting="Polite" />
    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8">
      <Button x:Name="PlayArchiveButton" Classes="primary-action" Content="{x:Static loc:ViewText.PlayFromArchive}"
              Command="{Binding PlayCommand}"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.PlaySelectedProgramFromTheArchive}"
              automation:AutomationProperties.AutomationId="archive-play" />
      <Button x:Name="RefreshGuideButton" Content="{x:Static loc:ViewText.RefreshEPG}" Command="{Binding RefreshCommand}"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.RefreshArchiveEPG}"
              automation:AutomationProperties.AutomationId="archive-refresh" />
    </StackPanel>
  </Grid>
</UserControl>
