<Window
    x:Class="TelePilot.App.Views.ProgramGuideWindow"
    x:DataType="vm:ProgramGuideViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:TelePilot.App.Localization"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:controls="using:TelePilot.App.Controls"
    xmlns:vm="using:TelePilot.App.ViewModels"
    Width="940"
    Height="700"
    MinWidth="660"
    MinHeight="500"
    ShowInTaskbar="True"
    Title="{x:Static loc:ViewText.TVGuideTelePilot}"
    WindowStartupLocation="CenterOwner"
    automation:AutomationProperties.Name="{x:Static loc:ViewText.TVGuide2}"
    automation:AutomationProperties.AutomationId="program-guide-window">

  <Window.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
  </Window.KeyBindings>

  <Grid
      Margin="20"
      RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
      RowSpacing="12"
      KeyboardNavigation.TabNavigation="Cycle">
    <TextBlock
        Classes="section-heading"
        Text="{x:Static loc:ViewText.TVGuide2}"
        automation:AutomationProperties.HeadingLevel="1" />

    <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="10">
      <Grid ColumnDefinitions="2*,1.2*,Auto" ColumnSpacing="10">
        <StackPanel>
          <Label Classes="field-label" Content="{x:Static loc:ViewText.Channel}" Target="ChannelPicker" />
          <controls:AccessibleComboBox
              x:Name="ChannelPicker"
              ItemsSource="{Binding Channels}"
              SelectedItem="{Binding SelectedChannel}"
              DisplayMemberPath="Name"
              automation:AutomationProperties.Name="{Binding ChannelSelectorAccessibleName}"
              automation:AutomationProperties.HelpText="{x:Static loc:ViewText.UseUpOrDownToSelect2}"
              automation:AutomationProperties.AutomationId="program-guide-channel" />
        </StackPanel>

        <StackPanel Grid.Column="1">
          <Label Classes="field-label" Content="{x:Static loc:ViewText.Date}" Target="ProgramDatePicker" />
          <controls:AccessibleDatePicker
              x:Name="ProgramDatePicker"
              SelectedDate="{Binding SelectedDate}"
              Watermark="{x:Static loc:ViewText.YYYYMMDD}"
              automation:AutomationProperties.Name="{Binding DateSelectorAccessibleName}"
              automation:AutomationProperties.HelpText="{x:Static loc:ViewText.UseLeftAndRightToChoose}"
              automation:AutomationProperties.AutomationId="program-guide-date" />
        </StackPanel>

        <Button
            x:Name="ShowDayButton"
            Grid.Column="2"
            VerticalAlignment="Bottom"
            Content="{x:Static loc:ViewText.ShowDay}"
            Command="{Binding LoadCommand}"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.ShowTVListingsForTheEntered}"
            automation:AutomationProperties.AutomationId="program-guide-show-date" />
      </Grid>

      <WrapPanel Grid.Row="1" HorizontalAlignment="Left">
        <Button
            x:Name="PreviousDayButton"
            Margin="0,0,8,0"
            Content="{x:Static loc:ViewText.PreviousDay}"
            Command="{Binding PreviousDayCommand}"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.PreviousDay}"
            automation:AutomationProperties.AutomationId="program-guide-previous-day" />
        <Button
            x:Name="TodayButton"
            Margin="0,0,8,0"
            Content="{x:Static loc:ViewText.TodayNow}"
            Command="{Binding GoToNowCommand}"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.GoToTheProgramCurrentlyOn}"
            automation:AutomationProperties.AutomationId="program-guide-now" />
        <Button
            x:Name="NextDayButton"
            Content="{x:Static loc:ViewText.NextDay}"
            Command="{Binding NextDayCommand}"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.NextDay}"
            automation:AutomationProperties.AutomationId="program-guide-next-day" />
      </WrapPanel>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <controls:AccessibleSearchBox
          x:Name="ProgramSearchBox"
          Text="{Binding SearchText, Mode=OneWayToSource}"
          Watermark="{x:Static loc:ViewText.ProgramTitle}"
          automation:AutomationProperties.Name="{x:Static loc:ViewText.SearchProgramsByTitle}"
          automation:AutomationProperties.AutomationId="program-guide-search" />
      <Button
          x:Name="ProgramSearchButton"
          Grid.Column="1"
          Content="{x:Static loc:ViewText.Search}"
          Command="{Binding LoadCommand}"
          automation:AutomationProperties.Name="{x:Static loc:ViewText.SearchPrograms}"
          automation:AutomationProperties.AutomationId="program-guide-search-submit" />
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="1.2*,1*" ColumnSpacing="12">
      <Grid RowDefinitions="Auto,*">
        <Label Classes="field-label" Content="{x:Static loc:ViewText.Programs}" Target="ProgramList" />
        <ListBox
            x:Name="ProgramList"
            Grid.Row="1"
            ItemsSource="{Binding Programs}"
            SelectedItem="{Binding SelectedProgram}"
            ContainerPrepared="OnProgramContainerPrepared"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.ProgramsForTheSelectedChannelAnd}"
            automation:AutomationProperties.HelpText="{x:Static loc:ViewText.UseTheArrowKeysToSelect2}"
            automation:AutomationProperties.AutomationId="program-guide-programs">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem
                  Header="{x:Static loc:ViewText.ScheduleAProgramRecording}"
                  Command="{Binding ScheduleProgrammeCommand}"
                  automation:AutomationProperties.Name="{x:Static loc:ViewText.ScheduleARecordingForTheSelected2}"
                  automation:AutomationProperties.AutomationId="program-context-schedule" />
              <MenuItem
                  Header="{x:Static loc:ViewText.ScheduleAChannelRecording}"
                  Command="{Binding ScheduleChannelCommand}"
                  automation:AutomationProperties.Name="{x:Static loc:ViewText.ScheduleARecordingForTheSelected}"
                  automation:AutomationProperties.AutomationId="program-context-schedule-channel" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProgramItemViewModel">
              <TextBlock
                  Padding="8,6"
                  Text="{Binding AccessibleName}"
                  TextWrapping="Wrap"
                  automation:AutomationProperties.AccessibilityView="Raw" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <Label Classes="field-label" Content="{x:Static loc:ViewText.ProgramDetails}" Target="ProgramDetails" />
        <controls:AccessibleTextBox
            x:Name="ProgramDetails"
            Grid.Row="1"
            Text="{Binding SelectedProgramDetails, Mode=OneWay}"
            IsReadOnly="True"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.SelectedProgramDetails}"
            automation:AutomationProperties.HelpText="{x:Static loc:ViewText.ReadOnlyFieldUseTheArrow2}"
            automation:AutomationProperties.AutomationId="program-guide-details" />
        <Button
            x:Name="ScheduleProgrammeButton"
            Grid.Row="2"
            HorizontalAlignment="Left"
            Content="{x:Static loc:ViewText.ScheduleARecording}"
            Command="{Binding ScheduleProgrammeCommand}"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.ScheduleARecordingForTheSelected2}"
            automation:AutomationProperties.AutomationId="program-guide-schedule-recording" />
      </Grid>
    </Grid>

    <TextBlock
        Grid.Row="4"
        Text="{Binding StatusMessage}"
        TextWrapping="Wrap"
        automation:AutomationProperties.Name="{x:Static loc:ViewText.TVGuideStatus}"
        automation:AutomationProperties.AutomationId="program-guide-status"
        automation:AutomationProperties.LiveSetting="Polite" />

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button
          x:Name="RefreshGuideButton"
          Content="{x:Static loc:ViewText.RefreshEPG}"
          Command="{Binding RefreshCommand}"
          automation:AutomationProperties.Name="{x:Static loc:ViewText.RefreshTVGuideData}"
          automation:AutomationProperties.AutomationId="program-guide-refresh" />
      <Button
          Content="{x:Static loc:ViewText.PlayChannel}"
          Command="{Binding PlayChannelCommand}"
          automation:AutomationProperties.Name="{x:Static loc:ViewText.PlaySelectedChannel2}"
          automation:AutomationProperties.AutomationId="program-guide-play-channel" />
      <Button
          x:Name="CloseGuideButton"
          Classes="primary-action"
          Content="{x:Static loc:ViewText.Close}"
          Click="OnCloseClick"
          automation:AutomationProperties.Name="{x:Static loc:ViewText.CloseTVGuide}"
          automation:AutomationProperties.AutomationId="program-guide-close" />
    </StackPanel>
  </Grid>
</Window>
