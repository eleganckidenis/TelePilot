<Window
    x:Class="TelePilot.App.Views.SettingsWindow"
    x:DataType="vm:SettingsWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:TelePilot.App.Localization"
    xmlns:automation="using:Avalonia.Automation"
    xmlns:controls="using:TelePilot.App.Controls"
    xmlns:vm="using:TelePilot.App.ViewModels"
    Width="720"
    Height="700"
    MinWidth="600"
    MinHeight="520"
    Title="{x:Static loc:ViewText.SettingsTelePilot}"
    WindowStartupLocation="CenterOwner"
    automation:AutomationProperties.Name="{x:Static loc:ViewText.TelePilotSettings}"
    automation:AutomationProperties.AutomationId="settings-window">
  <Grid Margin="20" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12" KeyboardNavigation.TabNavigation="Cycle">
    <TextBlock Classes="section-heading" Text="{x:Static loc:ViewText.Settings2}" automation:AutomationProperties.HeadingLevel="1" />
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
        <StackPanel>
          <Label Classes="field-label" Content="{x:Static loc:ViewText.ApplicationLanguage}" Target="LanguagePicker" />
          <controls:AccessibleComboBox x:Name="LanguagePicker" ItemsSource="{Binding LanguageOptions}"
              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" DisplayMemberPath="Name"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.ApplicationLanguage2}"
              automation:AutomationProperties.HelpText="{x:Static loc:ViewText.TheLanguageChangeTakesEffectAfter}"
              automation:AutomationProperties.AutomationId="settings-language" />
          <TextBlock Text="{x:Static loc:ViewText.TheLanguageChangeTakesEffectAfter}" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Classes="section-heading" Text="{x:Static loc:ViewText.ChannelList2}" automation:AutomationProperties.HeadingLevel="2" />
        <StackPanel>
          <Label Classes="field-label" Content="{x:Static loc:ViewText.ChannelSorting}" Target="SortPicker" />
          <controls:AccessibleComboBox
              x:Name="SortPicker"
              ItemsSource="{Binding SortOptions}"
              SelectedItem="{Binding SelectedSort}"
              DisplayMemberPath="Name"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.DefaultChannelSortOrder}"
              automation:AutomationProperties.AutomationId="settings-channel-sort" />
        </StackPanel>

        <TextBlock Classes="section-heading" Text="{x:Static loc:ViewText.NetworkBuffer}" automation:AutomationProperties.HeadingLevel="2" />
        <StackPanel>
          <Label Classes="field-label" Content="{x:Static loc:ViewText.TargetNetworkBufferInSeconds}" Target="BufferSecondsBox" />
          <controls:AccessibleTextBox x:Name="BufferSecondsBox" Text="{Binding BufferSeconds}"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.TargetNetworkBufferInSeconds}" automation:AutomationProperties.AutomationId="settings-buffer-seconds" />
        </StackPanel>
        <StackPanel>
          <Label Classes="field-label" Content="{x:Static loc:ViewText.MaximumNetworkBufferInSeconds}" Target="BufferMaximumBox" />
          <controls:AccessibleTextBox x:Name="BufferMaximumBox" Text="{Binding BufferMaximum}"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.MaximumNetworkBufferInSeconds}" automation:AutomationProperties.AutomationId="settings-buffer-maximum" />
        </StackPanel>
        <StackPanel>
          <Label Classes="field-label" Content="{x:Static loc:ViewText.HLSQualityLimitInMbpsZero}" Target="VariantCapBox" />
          <controls:AccessibleTextBox x:Name="VariantCapBox" Text="{Binding VariantCap}"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.HLSQualityLimitInMbpsZero}" automation:AutomationProperties.AutomationId="settings-variant-cap" />
        </StackPanel>
        <TextBlock Text="{x:Static loc:ViewText.ChangesApplyTheNextTimeYou}" TextWrapping="Wrap" />

        <TextBlock Classes="section-heading" Text="{x:Static loc:ViewText.TVGuideEPG}" automation:AutomationProperties.HeadingLevel="2" />
        <StackPanel Spacing="6">
          <Label Classes="field-label" Content="{x:Static loc:ViewText.ExternalEPGAddressOptional}" Target="ExternalEpgUrlBox" />
          <controls:AccessibleTextBox
              x:Name="ExternalEpgUrlBox"
              Text="{Binding ExternalEpgUrl}"
              Watermark="{x:Static loc:ViewText.HttpsGuideXmlOrGuideXml}"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.ExternalXMLTVEPGAddressOptional}"
              automation:AutomationProperties.HelpText="{x:Static loc:ViewText.AnHTTPOrHTTPSAddressReplaces}"
              automation:AutomationProperties.AutomationId="settings-external-epg-url" />
          <TextBlock
              Text="{x:Static loc:ViewText.ThisAddressOverridesThePlaylistS}"
              TextWrapping="Wrap" />
          <TextBlock Text="{Binding ExternalEpgPrivacyMessage}" TextWrapping="Wrap"
              automation:AutomationProperties.LiveSetting="Polite"
              automation:AutomationProperties.AutomationId="settings-external-epg-privacy" />
        </StackPanel>

        <TextBlock Classes="section-heading" Text="{x:Static loc:ViewText.TVArchiveSelectedSource}" automation:AutomationProperties.HeadingLevel="2" />
        <TextBlock Text="{Binding ArchiveSourceMessage}" TextWrapping="Wrap"
            automation:AutomationProperties.AutomationId="settings-archive-source-help" />
        <StackPanel Spacing="10" IsEnabled="{Binding HasArchiveSources}"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.ArchiveSettingsForTheSelectedSource}"
            automation:AutomationProperties.AutomationId="settings-archive-source-group">
          <StackPanel>
            <Label Classes="field-label" Content="{x:Static loc:ViewText.PlaylistSourceForArchive}" Target="ArchiveSourcePicker" />
            <controls:AccessibleComboBox
                x:Name="ArchiveSourcePicker"
                ItemsSource="{Binding ArchiveSources}"
                SelectedItem="{Binding SelectedArchiveSource}"
                DisplayMemberPath="Name"
                automation:AutomationProperties.Name="{x:Static loc:ViewText.PlaylistSourceForArchiveSettings}"
                automation:AutomationProperties.AutomationId="settings-archive-source" />
          </StackPanel>
          <StackPanel>
            <Label Classes="field-label" Content="{x:Static loc:ViewText.ArchiveType}" Target="ArchiveModePicker" />
            <controls:AccessibleComboBox
                x:Name="ArchiveModePicker"
                ItemsSource="{Binding ArchiveModeOptions}"
                SelectedItem="{Binding SelectedArchiveMode}"
                DisplayMemberPath="Name"
                automation:AutomationProperties.Name="{x:Static loc:ViewText.ArchiveTypeForTheSelectedSource}"
                automation:AutomationProperties.AutomationId="settings-archive-mode" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsEnabled="{Binding IsArchiveManual}">
            <StackPanel>
              <Label Classes="field-label" Content="{x:Static loc:ViewText.ArchiveDays}" Target="ArchiveDaysBox" />
              <controls:AccessibleTextBox
                  x:Name="ArchiveDaysBox"
                  Text="{Binding ArchiveRetentionDays}"
                  Watermark="{x:Static loc:ViewText.NumberOfDaysFromYourProvider}"
                  automation:AutomationProperties.Name="{x:Static loc:ViewText.ArchiveRetentionInDaysForThe}"
                  automation:AutomationProperties.HelpText="{x:Static loc:ViewText.RequiredInManualModeEnter0}"
                  automation:AutomationProperties.AutomationId="settings-archive-days" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <Label Classes="field-label" Content="{x:Static loc:ViewText.TimeCorrectionHours}" Target="ArchiveCorrectionBox" />
              <controls:AccessibleTextBox
                  x:Name="ArchiveCorrectionBox"
                  Text="{Binding ArchiveCorrectionHours}"
                  automation:AutomationProperties.Name="{x:Static loc:ViewText.ArchiveTimeCorrectionInHours}"
                  automation:AutomationProperties.HelpText="{x:Static loc:ViewText.EnterANumberFrom24To}"
                  automation:AutomationProperties.AutomationId="settings-archive-correction" />
            </StackPanel>
          </Grid>
          <CheckBox
              x:Name="ArchiveOverrideCheckBox"
              Content="{x:Static loc:ViewText.OverrideArchiveSettingsFromThePlaylist}"
              IsEnabled="{Binding IsArchiveManual}"
              IsChecked="{Binding OverrideArchivePlaylist}"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.OverrideArchiveSettingsFromThePlaylist}"
              automation:AutomationProperties.HelpText="{x:Static loc:ViewText.ManualSettingsFillInMissingData}"
              automation:AutomationProperties.AutomationId="settings-archive-override" />
        </StackPanel>

        <TextBlock Classes="section-heading" Text="{x:Static loc:ViewText.Recording}" automation:AutomationProperties.HeadingLevel="2" />
        <TextBlock
            Text="{x:Static loc:ViewText.VideoRecordingsAreSavedAsThe}"
            TextWrapping="Wrap"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.VideoRecordingFormatOriginalMPEGTS}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <StackPanel>
            <Label Classes="field-label" Content="{x:Static loc:ViewText.RecordingFolder}" Target="RecordingDirectoryBox" />
            <controls:AccessibleTextBox
                x:Name="RecordingDirectoryBox"
                Text="{Binding RecordingDirectory}"
                automation:AutomationProperties.Name="{x:Static loc:ViewText.RecordingFolder2}"
                automation:AutomationProperties.AutomationId="settings-recording-directory" />
          </StackPanel>
          <Button
              x:Name="BrowseRecordingDirectoryButton"
              Grid.Column="1"
              VerticalAlignment="Bottom"
              Content="{x:Static loc:ViewText.Browse}"
              Click="OnBrowseRecordingDirectory"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.ChooseRecordingFolder}"
              automation:AutomationProperties.AutomationId="settings-browse-recording-directory" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <StackPanel>
            <Label Classes="field-label" Content="{x:Static loc:ViewText.FFmpegFileOptional}" Target="FfmpegPathBox" />
            <controls:AccessibleTextBox
                x:Name="FfmpegPathBox"
                Text="{Binding FfmpegPath}"
                Watermark="{x:Static loc:ViewText.LeaveBlankToDetectAutomatically}"
                automation:AutomationProperties.Name="{x:Static loc:ViewText.OptionalPathToFfmpegExe}"
                automation:AutomationProperties.AutomationId="settings-ffmpeg-path" />
          </StackPanel>
          <Button
              Grid.Column="1"
              VerticalAlignment="Bottom"
              Content="{x:Static loc:ViewText.Browse}"
              Click="OnBrowseFfmpeg"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.ChooseFfmpegExe}"
              automation:AutomationProperties.AutomationId="settings-browse-ffmpeg" />
        </Grid>

        <Grid ColumnDefinitions="1.2*,1*" ColumnSpacing="10">
          <StackPanel>
            <Label Classes="field-label" Content="{x:Static loc:ViewText.AudioRecordingFormat}" Target="AudioFormatPicker" />
            <controls:AccessibleComboBox
                x:Name="AudioFormatPicker"
                ItemsSource="{Binding AudioFormats}"
                SelectedItem="{Binding SelectedAudioFormat}"
                DisplayMemberPath="Name"
                automation:AutomationProperties.Name="{x:Static loc:ViewText.AudioRecordingFormat2}"
                automation:AutomationProperties.AutomationId="settings-audio-format" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <Label Classes="field-label" Content="{x:Static loc:ViewText.AudioBitrateKbps}" Target="AudioBitratePicker" />
            <controls:AccessibleComboBox
                x:Name="AudioBitratePicker"
                ItemsSource="{Binding AudioBitrates}"
                SelectedItem="{Binding SelectedAudioBitrate}"
                automation:AutomationProperties.Name="{x:Static loc:ViewText.AudioRecordingBitrateInKilobitsPer}"
                automation:AutomationProperties.AutomationId="settings-audio-bitrate" />
          </StackPanel>
        </Grid>

        <StackPanel>
          <Label Classes="field-label" Content="{x:Static loc:ViewText.FileNameFormat}" Target="FileNameTemplateBox" />
          <controls:AccessibleTextBox
              x:Name="FileNameTemplateBox"
              Text="{Binding FileNameTemplate}"
              automation:AutomationProperties.Name="{x:Static loc:ViewText.RecordingFileNameFormat}"
              automation:AutomationProperties.HelpText="{x:Static loc:ViewText.AvailablePlaceholdersInBracesDateTime}"
              automation:AutomationProperties.AutomationId="settings-filename-template" />
          <TextBlock
              Text="{x:Static loc:ViewText.PlaceholdersDateTimeChannelProgrammeMode}"
              TextWrapping="Wrap"
              automation:AutomationProperties.AccessibilityView="Raw" />
        </StackPanel>

        <CheckBox
            Content="{x:Static loc:ViewText.WakeTheComputerBeforeScheduledRecordings}"
            IsChecked="{Binding WakeComputer}"
            automation:AutomationProperties.Name="{x:Static loc:ViewText.WakeTheComputerBeforeScheduledRecordings}"
            automation:AutomationProperties.AutomationId="settings-wake-computer" />
      </StackPanel>
    </ScrollViewer>

    <TextBlock
        Grid.Row="2"
        Text="{Binding ValidationMessage}"
        TextWrapping="Wrap"
        automation:AutomationProperties.Name="{x:Static loc:ViewText.SettingsError}"
        automation:AutomationProperties.LiveSetting="Assertive"
        automation:AutomationProperties.AutomationId="settings-validation" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button
          x:Name="CancelButton"
          Content="{x:Static loc:ViewText.Cancel}"
          Command="{Binding CancelCommand}"
          automation:AutomationProperties.Name="{x:Static loc:ViewText.DiscardSettingsChanges}"
          automation:AutomationProperties.AutomationId="settings-cancel" />
      <Button
          x:Name="SaveButton"
          Classes="primary-action"
          Content="{x:Static loc:ViewText.Save}"
          automation:AutomationProperties.Name="{x:Static loc:ViewText.SaveSettings}"
          automation:AutomationProperties.AutomationId="settings-save" />
    </StackPanel>
  </Grid>
</Window>
