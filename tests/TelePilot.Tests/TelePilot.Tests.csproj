    <ProjectReference Include="..\..\src\TelePilot.Epg\TelePilot.Epg.csproj" />
    <ProjectReference Include="..\..\src\TelePilot.Infrastructure\TelePilot.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\TelePilot.Playback\TelePilot.Playback.csproj" />
    <ProjectReference Include="..\..\src\TelePilot.Playlists\TelePilot.Playlists.csproj" />
    <ProjectReference Include="..\..\src\TelePilot.Recording\TelePilot.Recording.csproj" />
  </ItemGroup>

